{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "action/index.html",
    "default_title": "ai-site-skin-mask"
  },
  "chromium:manifest_version": 3,
  "content_scripts": [
    {
      "js": [
        "sites/chatgpt/index.ts"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "sites/claude/index.ts"
      ],
      "matches": [
        "https://claude.ai/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "sites/grok/index.ts"
      ],
      "matches": [
        "https://grok.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "浏览器插件：把 chatgpt.com / claude.ai 等网页版 AI 的界面换成 deepseek / doubao / qwen 风格（mask 换肤，不破坏原有功能）",
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "action/index.html",
    "default_title": "ai-site-skin-mask"
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "id": "extension-workflow@experiment"
    }
  },
  "firefox:manifest_version": 2,
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "name": "ai-site-skin-mask",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/deepseek-logo.svg",
        "images/deepseek-icon.svg",
        "images/deepseek-favicon.svg",
        "images/qwen-logo.svg",
        "images/qwen-logo-dark.svg",
        "images/qwen-favicon.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*"
      ]
    }
  ]
}
