{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "action/index.html",
    "default_title": "Ai Site Mask"
  },
  "chromium:manifest_version": 3,
  "content_scripts": [
    {
      "js": [
        "sites/chatgpt/index.ts"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "sites/claude/index.ts"
      ],
      "matches": [
        "https://claude.ai/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "sites/grok/index.ts"
      ],
      "matches": [
        "https://grok.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "sites/gemini/index.ts"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "将 ChatGPT、Claude 等 AI 网站的界面伪装成 Qwen（qwen.ai 国际站）或 DeepSeek 风格，保留原生功能。",
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "action/index.html",
    "default_title": "Ai Site Mask"
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "id": "extension-workflow@experiment"
    }
  },
  "firefox:manifest_version": 2,
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "name": "Ai Site Mask",
  "version": "0.0.1",
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/deepseek-logo.svg",
        "images/deepseek-icon.svg",
        "images/deepseek-favicon.svg",
        "images/qwen-logo.svg",
        "images/qwen-logo-dark.svg",
        "images/qwen-favicon.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
